# ai_trade_program — copy to ai_trade_program/.env or merge into repo-root .env
#
# Website login uses the same credentials as Main_Website (Trading Platform/.env):
# WEBSITE-USERNAME, WEBSITE-PASSWORD, WEBSITE_SESSION_SECRET, WEBSITE_SESSION_SECURE

# Flask bind (optional)
# AI_TRADE_PROGRAM_HOST=127.0.0.1
# AI_TRADE_PROGRAM_PORT=5077

# Trading 212 (dedicated AI / sandbox account)
T212_ENV_AI=demo
TRADING_212_KEY_AI=
TRADING_212_SECRET_AI=

# OpenAI — Reasoning Test lab + optional scanner grader backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# AI_OPENAI_MODEL=gpt-5-nano
# AI_OPENAI_PRICE_TABLE_JSON={"gpt-5-nano":{"in":0.05,"out":0.40}}

# Scanner grader (default: Gemini 3.1 Flash Lite, thinking off)
# AI_GRADER_PROVIDER=gemini
# AI_GRADER_MODEL=gemini-3.1-flash-lite
# AI_GRADER_THINKING=0
# AI_GRADER_THINKING_LEVEL=LOW
# AI_GRADER_MAX_OUTPUT_TOKENS=4096

# Master switch for background engine (1 = run scanners/monitors)
AI_TRADING_ENABLED=0

# Slot sizing (GBP) — per slot = (available cash − withheld profits) ÷ SLOT_COUNT
# AI_REINVEST_PROFIT_FRACTION=0.5
# SLOT_CAPITAL_GBP=5000
# GBP_USD_RATE=1.27

# News-scanner Discord feed (audit log only — does not trade)
# AI_NEWS_SCANNER_ENABLED=0
