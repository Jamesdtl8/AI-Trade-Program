# ai_trade_program — copy to ai_trade_program/.env or merge into repo-root .env
#
# Website login uses the same credentials as Main_Website (Trading Platform/.env):
# WEBSITE-USERNAME, WEBSITE-PASSWORD, WEBSITE_SESSION_SECRET, WEBSITE_SESSION_SECURE

# Flask bind (optional)
# AI_TRADE_PROGRAM_HOST=127.0.0.1
# AI_TRADE_PROGRAM_PORT=5077

# Trading 212 (dedicated AI / sandbox account)
T212_ENV_AI=demo
TRADING_212_KEY_AI=
TRADING_212_SECRET_AI=

# OpenAI — Reasoning Test lab + optional scanner grader backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# AI_OPENAI_MODEL=gpt-5-nano
# AI_OPENAI_PRICE_TABLE_JSON={"gpt-5-nano":{"in":0.05,"out":0.40}}

# Scanner grader (default: Gemini 3.1 Flash Lite, thinking off)
# AI_GRADER_PROVIDER=gemini
# AI_GRADER_MODEL=gemini-3.1-flash-lite
# AI_GRADER_THINKING=0
# AI_GRADER_THINKING_LEVEL=LOW
# AI_GRADER_MAX_OUTPUT_TOKENS=4096

# Master switch for background engine (1 = run scanners/monitors)
AI_TRADING_ENABLED=0

# Candle-close trading model (1 = default on; replaces AI grader execution path)
# AI_CANDLE_MODEL=1
# AI_CANDLE_ALERT_ENTRY=1
# AI_CANDLE_ENTRY_GAP_PCT=3
# AI_CANDLE_STAKE_GBP=10000
# AI_CANDLE_POLL_SECONDS=1
# AI_CANDLE_TICK_BARS=1
# AI_CANDLE_STOP_BAR_SEC=60
# AI_CANDLE_STOP_LOSS_PCT=10
# AI_CANDLE_EMERGENCY_STOP_PCT=18
# AI_CANDLE_PROFIT_ON_TICK=1
# AI_CANDLE_PROFIT_BAR_SEC=15
# AI_CANDLE_LOSS_FILTERS=1
# AI_CANDLE_SCRATCH_90S=1
# AI_CANDLE_SCRATCH_PEAK_PCT=3
# AI_CANDLE_SCRATCH_GREEN_PCT=0.5
# AI_CANDLE_SCRATCH_MAX_ALERT=4
# AI_CANDLE_TICKER_LOSS_COOLDOWN_MIN=60
# AI_CANDLE_TICKER_ANY_EXIT_COOLDOWN_MIN=30
# AI_CANDLE_MAX_TRADES_PER_TICKER_DAY=2
# AI_CANDLE_MAX_ENTRY_CHASE_PCT=8
# AI_CANDLE_SQUEEZE_REENTRY_MIN_ALERT=6
# AI_CANDLE_INTRABAR_RAMP=1
# AI_CANDLE_STALE_QUOTE_SEC=90
# AI_CANDLE_SELL_WATCHDOG_SEC=30
# AI_CANDLE_SQUEEZE_DEAD_SCRATCH=1
# AI_CANDLE_SQUEEZE_DEAD_SCRATCH_PEAK_PCT=1
# AI_ENTRY_AI_VALIDATE=1
# AI_ENTRY_AI_MODEL=gemini-3.1-flash-lite

# Slot sizing (GBP) — per slot = (available cash − withheld profits) ÷ SLOT_COUNT
# AI_REINVEST_PROFIT_FRACTION=0.5
# SLOT_CAPITAL_GBP=5000
# GBP_USD_RATE=1.27

# News-scanner Discord feed (audit log only — does not trade)
# AI_NEWS_SCANNER_ENABLED=0

# Discord #ai-trade buy signals (posts TRADE decisions via relay)
# AI_TRADE_DISCORD_CHANNEL_ID=1512387992243929088
# DISCORD_RELAY_URL=http://127.0.0.1:5061

# Runner exit: once peak gain hits arm %, sell if P&L gives back more than cap pp from peak
# AI_PEAK_GIVEBACK_ARM_PCT=50
# AI_PEAK_GIVEBACK_CAP_PCT=25

# Hard stop-loss % below entry (position monitor + entry stop clamp)
# AI_MAX_STOP_LOSS_PCT=10

# Massive.com live data (loaded from ../Trading Platform/.env if not set here)
# MASSIVE_API_KEY=
# MASSIVE_WS_QUOTES=1
# MASSIVE_WS_DELAYED=0
# Open a Massive websocket from THIS app (0 = off; Trading Platform keeps the sole connection)
# AI_MASSIVE_WS=0

# ── Discord Trader (James' trader-tracker channel copy system) ────────────────
# Taps the SAME scanner_feed.jsonl the AI scanner already reads — no new bot needed.
# Just set the channel ID for trader-tracker and add the second T212 account key.
# DISCORD_TRADER_ENABLED=0
#
# Channel snowflake ID for James' trader-tracker channel (from the existing relay)
# DISCORD_TRADER_CHANNEL_ID=
#
# Trading 212 credentials for the Discord Trader account (separate from AI scanner)
# T212_ENV_DISCORD=live
# TRADING_212_KEY_DISCORD=
#
# Max stake per trade in GBP (default £10,000)
# DISCORD_TRADER_STAKE_GBP=10000
#
# Take-profit: sell on 1s tick when unrealised gain reaches this % (default 8%)
# DISCORD_TRADER_TP_PCT=8
